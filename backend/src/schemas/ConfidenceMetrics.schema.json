{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://api.propertea.local/schemas/ConfidenceMetrics.schema.json",
  "title": "Confidence Metrics Schema",
  "description": "Schema for confidence and uncertainty quantification in recommendations",
  "type": "object",
  "required": ["overall"],
  "properties": {
    "overall": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "description": "Overall confidence percentage (0-100)"
    },
    "data": {
      "type": ["integer", "null"],
      "minimum": 0,
      "maximum": 100,
      "description": "Data completeness confidence (0-100)"
    },
    "agreement": {
      "type": ["integer", "null"],
      "minimum": 0,
      "maximum": 100,
      "description": "Factor agreement confidence (0-100)"
    },
    "label": {
      "type": "string",
      "enum": ["Very High", "High", "Moderate", "Low", "Very Low"],
      "description": "Human-readable confidence level"
    },
    "dataQuality": {
      "type": ["string", "null"],
      "enum": ["Very High", "High", "Moderate", "Low", "Very Low", null],
      "description": "Alternative label property for backward compatibility"
    }
  },
  "additionalProperties": false
}
