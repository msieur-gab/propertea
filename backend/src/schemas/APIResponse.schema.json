{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://api.propertea.local/schemas/APIResponse.schema.json",
  "title": "API Response Schema",
  "description": "Standard schema for all API responses",
  "type": "object",
  "required": ["success", "data"],
  "properties": {
    "success": {
      "type": "boolean",
      "description": "Whether the request was successful"
    },
    "data": {
      "type": "object",
      "description": "Response payload (structure varies by endpoint)"
    },
    "metadata": {
      "type": "object",
      "description": "Response metadata",
      "properties": {
        "requestId": {
          "type": "string",
          "description": "Unique request identifier for tracking"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of response"
        },
        "version": {
          "type": "string",
          "description": "API version"
        },
        "processingTimeMs": {
          "type": "number",
          "description": "Processing time in milliseconds"
        }
      }
    },
    "error": {
      "type": "object",
      "description": "Error information (only present if success is false)",
      "properties": {
        "code": {
          "type": "string",
          "description": "Error code (e.g., VALIDATION_ERROR, NOT_FOUND)"
        },
        "message": {
          "type": "string",
          "description": "Human-readable error message"
        },
        "details": {
          "type": "object",
          "description": "Additional error details"
        },
        "path": {
          "type": "string",
          "description": "API endpoint path"
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" },
          "field": { "type": ["string", "null"] }
        }
      },
      "description": "Non-critical warnings (e.g., missing optional data, data quality concerns)"
    }
  },
  "additionalProperties": false
}
